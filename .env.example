# Copy to .env.local and fill in real values. Never commit the filled-in copy.
# This file contains placeholders only.

# ---------------------------------------------------------------------------
# Database (Neon / any Postgres 16+ with pgvector and lakebase_text)
# ---------------------------------------------------------------------------
# Pooled (PgBouncer transaction mode) - runtime query traffic.
# On Neon the pooled hostname contains "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct (bypasses PgBouncer) - REQUIRED for schema migrations and
# CREATE EXTENSION. Same hostname without the "-pooler" segment.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Embedding model (open source, runs locally - no inference API is used)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Search tuning
# ---------------------------------------------------------------------------
# Maximum results returned per query.
SEARCH_TOP_K=8
# Minimum cosine similarity for a passage to be considered relevant.
# Calibrated against this corpus: unrelated questions peak near 0.28, the
# weakest genuine match measured was 0.61. Raise it to be stricter.
SEARCH_THRESHOLD=0.38

# ---------------------------------------------------------------------------
# Answering (optional)
# ---------------------------------------------------------------------------
# Retrieval works without any of this. The answer box falls back to composing
# a quote directly from the passages, which cites correctly but cannot
# synthesise.
#
# The model runs on Groq's API rather than in the function: the deployment
# bundle has 250 MB to spend, the embedder already uses 89 MB of it, and the
# smallest local instruct model that fits (131 MB) was measured and could not
# follow a citation instruction at all.
GROQ_API_KEY=gsk_REPLACE_ME

# Models tried in order; the first that responds wins. They are separate quota
# buckets, so falling back between them absorbs a per-model rate limit rather
# than a provider outage. Comma-separated.
ANSWER_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
